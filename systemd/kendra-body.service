[Unit]
Description=Kendra body control service
After=kendra-reflex.service
Wants=kendra-reflex.service

[Service]
Type=simple
User=kendra
Group=kendra
SupplementaryGroups=i2c gpio
EnvironmentFile=-/etc/kendra/kendra.env
WorkingDirectory=/opt/kendra/current
ExecStart=/opt/kendra/current/.venv/bin/kendra --config /etc/kendra/production.yaml service body
Restart=always
RestartSec=1
RuntimeDirectory=kendra
StateDirectory=kendra
UMask=0007
# Memory-pressure policy: senses and speech are sacrificed before safety.
OOMScoreAdjust=-800

[Install]
WantedBy=multi-user.target
