[Unit]
Description=Kendra local Moondream semantic vision server
After=local-fs.target

[Service]
Type=simple
User=kendra
Group=kendra
EnvironmentFile=/etc/kendra/kendra.env
WorkingDirectory=/opt/kendra/current
ExecStart=/opt/kendra/current/third_party/llama.cpp/build/bin/llama-server -m /var/lib/kendra/models/moondream2/moondream2-text-model-Q4_K_M.gguf --mmproj /var/lib/kendra/models/moondream2/moondream2-mmproj-f16.gguf --host 127.0.0.1 --port 8081 -c 2048 -np 1 --threads 3 --no-jinja --mlock --cors-origins localhost --no-cors-credentials
Restart=always
RestartSec=3
StateDirectory=kendra
UMask=0007
# Memory-pressure policy: senses and speech are sacrificed before safety.
OOMScoreAdjust=400

[Install]
WantedBy=multi-user.target
