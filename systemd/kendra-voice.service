[Unit]
Description=Kendra local speech service
After=kendra-agent.service
Wants=kendra-agent.service

[Service]
Type=simple
User=kendra
Group=kendra
SupplementaryGroups=audio
EnvironmentFile=-/etc/kendra/kendra.env
WorkingDirectory=/opt/kendra/current
ExecStart=/opt/kendra/current/.venv/bin/kendra --config /etc/kendra/production.yaml service voice
Restart=always
RestartSec=2
RuntimeDirectory=kendra
StateDirectory=kendra
UMask=0007

[Install]
WantedBy=multi-user.target
