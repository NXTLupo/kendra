[Unit]
Description=Kendra Brain persistent cognition service
After=local-fs.target

[Service]
Type=simple
User=kendra
Group=kendra
EnvironmentFile=-/etc/kendra/kendra.env
WorkingDirectory=/opt/kendra/current
ExecStart=/opt/kendra/current/.venv/bin/kendra --config /etc/kendra/production.yaml service brain
Restart=always
RestartSec=2
RuntimeDirectory=kendra
StateDirectory=kendra
UMask=0007

[Install]
WantedBy=multi-user.target
