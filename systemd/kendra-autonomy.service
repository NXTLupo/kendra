[Unit]
Description=Kendra bounded autonomous mission scheduler
After=kendra-agent.service kendra-body.service kendra-brain.service
Wants=kendra-agent.service kendra-body.service kendra-brain.service

[Service]
Type=simple
User=kendra
Group=kendra
EnvironmentFile=-/etc/kendra/kendra.env
WorkingDirectory=/opt/kendra/current
ExecStart=/opt/kendra/current/.venv/bin/kendra --config /etc/kendra/production.yaml service autonomy
Restart=always
RestartSec=5
RuntimeDirectory=kendra
StateDirectory=kendra
UMask=0007

[Install]
WantedBy=multi-user.target
