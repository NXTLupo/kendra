[Unit]
Description=Kendra whitelisted photo delivery service
After=network.target

[Service]
Type=simple
User=kendra
Group=kendra
EnvironmentFile=-/etc/kendra/kendra.env
WorkingDirectory=/opt/kendra/current
ExecStart=/opt/kendra/current/.venv/bin/kendra --config /etc/kendra/production.yaml service delivery
Restart=always
RestartSec=2
RuntimeDirectory=kendra
StateDirectory=kendra
UMask=0007

[Install]
WantedBy=multi-user.target
